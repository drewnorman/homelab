# Keep the hosted-tool resource disabled during the first-stage apply. Before
# enabling it, change every applicable organization hosted-tool policy from
# "all projects" to "selected projects" in the OpenAI dashboard.
enable_hosted_tool_permissions = false

# After the project exists, run:
#   tofu -chdir=terraform/openai output available_model_rate_limits
# Copy the exact OpenAI-created record IDs here. terraform.tfvars is ignored.
model_rate_limit_ids = {}

